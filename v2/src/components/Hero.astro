---
/**
 * The identity block. A reader arriving cold should be able to answer "who is
 * this and why should I read on" in about ten seconds, so the statement is set
 * large and the supporting detail is demoted to the margin: portrait, working
 * note, and a few links.
 *
 * The keyword line replaces the credential list that used to sit here. Titles
 * and paper counts describe a record; keywords tell a reader whether they are
 * in the right place.
 */
import { profile } from '../data/profile';
---

<section class="hero block">
  <div class="statement">
    <p class="who">
      <span class="dot"></span>
      {profile.role}, {profile.employer} · {profile.location}
    </p>
    <h1>
      {profile.statement.lines.map((line) => <span>{line}</span>)}
      <span class="coda">{profile.statement.coda}</span>
    </h1>
    <p class="keywords">
      {profile.keywords.map((keyword, i) => (
        <>
          {i > 0 && <span class="sep">·</span>}
          {keyword}
        </>
      ))}
    </p>
  </div>

  <aside class="margin">
    <img
      class="portrait"
      src={profile.photo}
      alt={profile.shortName}
      width="112"
      height="112"
    />
    <p class="hand">{profile.workingNote}</p>
    <div class="links">
      <a href="/air">Team AIR</a>
      <a href={profile.links.scholar}>Scholar</a>
      <a href={profile.links.linkedin}>LinkedIn</a>
      <a href="/cv">Full CV</a>
    </div>
  </aside>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.75fr) minmax(210px, 0.85fr);
    gap: clamp(1.75rem, 4vw, 3.5rem);
    align-items: start;
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
    padding-bottom: clamp(0.5rem, 1.5vw, 1rem);
  }
  .who {
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--pencil);
    margin: 0 0 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    flex: none;
  }
  h1 {
    margin: 0;
    font-size: clamp(1.85rem, 5.1vw, 3.15rem);
    font-weight: 500;
    line-height: 1.14;
    letter-spacing: -0.024em;
  }
  h1 span {
    display: block;
  }
  .coda {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-size: 0.46em;
    line-height: 1.5;
    color: var(--pencil);
    margin-top: 0.8rem;
    letter-spacing: 0;
    max-width: 34ch;
  }
  .keywords {
    margin: 1.9rem 0 0;
    padding-top: 1.1rem;
    border-top: 1px solid var(--rule);
    font-family: var(--mono);
    font-size: 11.5px;
    line-height: 2;
    letter-spacing: 0.03em;
    color: var(--ink-70);
  }
  .keywords .sep {
    color: var(--accent);
    margin: 0 0.5em;
  }

  .margin {
    border-left: 1px solid var(--rule);
    padding-left: clamp(1rem, 2vw, 1.75rem);
  }
  .portrait {
    display: block;
    width: 112px;
    height: 112px;
    border-radius: 50%;
    object-fit: cover;
    margin: 0 auto 1.15rem;
    border: 1px solid var(--rule);
  }
  .hand {
    font-family: var(--serif);
    font-style: italic;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--ink-70);
    margin: 0 0 1.4rem;
  }
  .links {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    font-family: var(--mono);
    font-size: 11.5px;
  }
  .links a {
    color: var(--pencil);
    text-decoration: none;
    border-bottom: 1px dotted var(--rule);
    width: fit-content;
  }
  .links a:hover,
  .links a:focus-visible {
    color: var(--accent-ink);
    border-bottom-style: solid;
    border-bottom-color: var(--accent-ink);
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .margin {
      border-left: 0;
      border-top: 1px solid var(--rule);
      padding-left: 0;
      padding-top: 1.25rem;
    }
    .links {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.9rem;
    }
  }
</style>
