---
/**
 * Systems and case studies.
 *
 * v1 presented these as a client portfolio, which reads as consultancy
 * marketing. The interesting claim is narrower and stronger: these are systems
 * that ran in production, and several of them are why the papers exist. So the
 * software comes first, and each case study says what the system did rather than
 * how transformative it was.
 */
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { getProjects } from '../lib/content';

const projects = await getProjects();
const software = projects.filter((project) => project.data.kind === 'software');
const cases = projects
  .filter((project) => project.data.kind === 'case-study')
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured));
---

<Base
  title="Projects"
  description="Research software and production systems: recommender frameworks, real-time personalization, and industry case studies."
>
  <section class="block">
    <h1 class="page-title">Systems that ran in production</h1>
    <p class="page-lede">
      Research frameworks and the deployments that tested them. Most of the papers on this site exist because one of
      these systems was carrying real traffic and did something unexpected.
    </p>
  </section>

  <section class="block">
    <SectionHeader n="01" label="Research software" />
    <ul class="soft">
      {
        software.map((project) => (
          <li>
            <h3>
              {project.data.url ? <a href={project.data.url}>{project.data.title}</a> : project.data.title}
              {project.data.years && <span class="years">{project.data.years}</span>}
            </h3>
            <p>{project.data.summary}</p>
            {project.data.detail && <p class="detail">{project.data.detail}</p>}
            <p class="acts">
              {project.data.url && <a class="act" href={project.data.url}>site</a>}
              {project.data.repo && <a class="act" href={project.data.repo}>code</a>}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="block">
    <SectionHeader n="02" label={`Case studies (${cases.length})`} />
    <ul class="cases">
      {
        cases.map((project) => (
          <li class:list={{ featured: project.data.featured, noshot: !project.data.image }}>
            {project.data.image && (
              <div class="shot">
                <img src={project.data.image} alt="" loading="lazy" decoding="async" />
              </div>
            )}
            <div class="body">
              <h3>
                {project.data.title}
                {project.data.partner && <span class="partner">{project.data.partner}</span>}
              </h3>
              <p>{project.data.summary}</p>
              {project.data.detail && <p class="detail">{project.data.detail}</p>}
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .soft {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem 2.5rem;
  }
  .soft li {
    border-top: 1px solid var(--rule);
    padding-top: 0.9rem;
  }
  .soft h3,
  .cases h3 {
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 0.35rem;
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .soft h3 a {
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
  }
  .soft h3 a:hover,
  .soft h3 a:focus-visible {
    color: var(--accent-ink);
    border-bottom-color: var(--accent-ink);
  }
  .years,
  .partner {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--pencil);
    font-weight: 400;
  }
  .soft p,
  .cases p {
    font-family: var(--serif);
    font-size: 0.93rem;
    line-height: 1.6;
    margin: 0;
    color: var(--ink-70);
  }
  .detail {
    margin-top: 0.4rem !important;
    font-size: 0.88rem !important;
    color: var(--pencil) !important;
  }
  .acts {
    display: flex;
    gap: 0.4rem;
    margin-top: 0.6rem;
  }
  .acts:empty {
    display: none;
  }

  .cases {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .cases li {
    display: grid;
    grid-template-columns: 148px 1fr;
    gap: 1.5rem;
    padding: 1.25rem 0;
    align-items: start;
  }
  .cases li + li {
    border-top: 1px dotted var(--rule);
  }
  /* Without a screenshot there is no first column to fill, so the text takes the
     whole row instead of being squeezed into the 148px image slot. */
  .cases li.noshot {
    grid-template-columns: 1fr;
  }
  .cases li:first-child {
    padding-top: 0;
  }
  .shot {
    border: 1px solid var(--rule);
    background: var(--grid);
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .cases li.featured h3 {
    font-size: 1.06rem;
  }
  @media (max-width: 620px) {
    .cases li {
      grid-template-columns: 1fr;
      gap: 0.9rem;
    }
    .shot {
      max-width: 200px;
    }
  }
</style>
