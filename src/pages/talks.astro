---
import Base from '../layouts/Base.astro';
import TalkList from '../components/TalkList.astro';
import { profile } from '../data/profile';
import { getTalks } from '../lib/content';

const talks = await getTalks();
const years = [...new Set(talks.map((talk) => talk.data.date.getUTCFullYear()))].sort((a, b) => b - a);
---

<Base title="Talks" description="Conference talks, keynotes and panels on applied AI, recommender systems and building with LLMs.">
  <section class="block">
    <h1 class="page-title">Talks</h1>
    <p class="page-lede">
      Slides are linked where they exist. If you would like a version of one of these for your event or team, or
      something new on applied AI research in production, <a href={`mailto:${profile.email}`}>get in touch</a>.
    </p>
  </section>

  {
    talks.length === 0 ? (
      <section class="block"><p>Nothing listed yet.</p></section>
    ) : (
      years.map((year) => (
        <section class="block block--tight">
          <h2 class="year">{year}</h2>
          <TalkList talks={talks.filter((talk) => talk.data.date.getUTCFullYear() === year)} showDescription />
        </section>
      ))
    )
  }
</Base>

<style>
  .page-lede a {
    color: var(--accent-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
  }
  .year {
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.11em;
    color: var(--pencil);
    margin: 0 0 1.2rem;
    padding-bottom: 0.45rem;
    border-bottom: 1px solid var(--rule);
  }
</style>
