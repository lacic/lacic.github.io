---
/**
 * The log: dated entries with a standfirst. Used on the landing page (latest
 * three) and on /updates (everything).
 */
import type { CollectionEntry } from 'astro:content';
import { formatDay, typeLabel } from '../lib/format';

interface Props {
  posts: CollectionEntry<'updates'>[];
  /** Show the tag row. Off on the landing page, where space is tighter. */
  showTags?: boolean;
}

const { posts, showTags = false } = Astro.props;
---

<ol class="log">
  {
    posts.map((post) => (
      <li>
        <a class="row" href={`/updates/${post.id}`}>
          <span class="date">{formatDay(post.data.date)}</span>
          <span class="body">
            <span class="head">
              <span class="kind">{typeLabel(post.data.type)}</span>
              {post.data.series && (
                <span class="pill">
                  {post.data.series.name} · part {post.data.series.part}
                </span>
              )}
              {post.data.draft && <span class="pill pill--accent">draft</span>}
            </span>
            <span class="title">{post.data.title}</span>
            <span class="stand">{post.data.standfirst}</span>
            {showTags && post.data.tags.length > 0 && (
              <span class="tags">
                {post.data.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </span>
            )}
          </span>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .log {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .log li + li {
    border-top: 1px dotted var(--rule);
  }
  .row {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 0 1.5rem;
    padding: 1.15rem 0;
    text-decoration: none;
    color: inherit;
  }
  .log li:first-child .row {
    padding-top: 0;
  }
  .date {
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--pencil);
    padding-top: 0.3rem;
    white-space: nowrap;
  }
  .head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.3rem;
  }
  .kind {
    font-family: var(--mono);
    font-size: 9.5px;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }
  .title {
    display: block;
    font-size: 1.06rem;
    font-weight: 500;
    line-height: 1.32;
    max-width: 48ch;
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 3px;
  }
  .row:hover .title,
  .row:focus-visible .title {
    text-decoration-color: var(--accent);
  }
  .stand {
    display: block;
    font-family: var(--serif);
    font-size: 0.95rem;
    color: var(--ink-70);
    margin-top: 0.25rem;
    max-width: 62ch;
  }
  .tags {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
    margin-top: 0.6rem;
  }
  @media (max-width: 620px) {
    .row {
      grid-template-columns: 1fr;
    }
    .date {
      padding: 0 0 0.35rem;
    }
  }
</style>
