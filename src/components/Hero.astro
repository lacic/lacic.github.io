---
/**
 * The identity block. A reader arriving cold should be able to answer "who is
 * this and why should I read on" in about ten seconds, so the statement is set
 * large and the supporting detail is demoted to the margin: portrait, working
 * note, and a few links.
 *
 * The keyword line replaces the credential list that used to sit here. Titles
 * and paper counts describe a record; keywords tell a reader whether they are
 * in the right place.
 */
import { profile } from '../data/profile';

const links: {
  href: string;
  label: string;
  icon: 'air' | 'scholar' | 'linkedin' | 'cv';
  external?: boolean;
}[] = [
  {
    href: '/air',
    label: 'Team AIR',
    icon: 'air',
  },
  {
    href: profile.links.scholar,
    label: 'Scholar',
    icon: 'scholar',
    external: true,
  },
  {
    href: profile.links.linkedin,
    label: 'LinkedIn',
    icon: 'linkedin',
    external: true,
  },
  {
    href: '/cv',
    label: 'Full CV',
    icon: 'cv',
  },
];
---

<section class="hero block">
  <div class="statement">
    <p class="who">
      <span class="dot"></span>
      {profile.role}, {profile.employer} · {profile.location}
    </p>
    <h1>
      {profile.statement.lines.map((line) => <span>{line}</span>)}
      <span class="coda">{profile.statement.coda}</span>
    </h1>
    <p class="keywords">
      {profile.keywords.map((keyword, i) => (
        <>
          {i > 0 && <span class="sep">·</span>}
          {keyword}
        </>
      ))}
    </p>
  </div>

  <aside class="margin">
    <img
      class="portrait"
      src={profile.photo}
      alt={profile.shortName}
      width="112"
      height="112"
    />
    <p class="hand">{profile.workingNote}</p>
    <div class="links">
      {
        links.map((link) => (
          <a
            href={link.href}
            {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            <span class="ico" aria-hidden="true">
              {link.icon === 'air' && (
                <svg viewBox="0 0 300 300" fill="currentColor">
                  <path d="M235.875 235.875C219.45 252.275 187.375 262.05 150 262.05C112.625 262.05 80.5 252.275 64.15 235.875C47.75 219.45 37.925 187.375 37.925 150C37.925 112.625 47.75 80.55 64.15 64.15C80.525 47.725 112.65 37.925 150 37.925C187.35 37.925 219.45 47.75 235.875 64.15C252.225 80.575 262.05 112.65 262.05 150C262.05 187.35 252.225 219.45 235.875 235.875ZM299.975 149.975C300 67.15 232.825 0 150 0C67.175 0 0 67.15 0 150C0 232.85 67.15 300 150 300C232.85 300 300 232.85 300 150L299.975 149.975Z" />
                  <path d="M180 128.8V171.15C180 176.05 176.05 179.975 171.225 179.975H128.775C123.925 179.975 120 176.05 120 171.15V128.8C120 123.9 123.925 119.975 128.775 119.975H171.225C176.05 119.975 180 123.9 180 128.8Z" />
                  <path d="M220.725 79.25C209.025 67.55 181.275 60 149.975 60C118.7 60 90.9248 67.575 79.2248 79.25C67.4748 90.925 59.9748 118.725 59.9748 150C59.9748 181.275 67.4748 209.075 79.2248 220.75C90.9248 232.425 118.675 240 149.975 240C181.25 240 209.025 232.425 220.725 220.75C232.475 209.05 239.975 181.275 239.975 150C239.975 118.725 232.475 90.925 220.725 79.25ZM193.4 193.1C190.95 195.55 183.525 202.975 149.775 202.975C116.025 202.975 108.55 195.575 106.15 193.1C103.7 190.65 96.2748 183.225 96.2748 149.5C96.2748 115.775 103.675 108.35 106.15 105.9C108.55 103.45 115.975 96.075 149.775 96.075C183.575 96.075 190.95 103.425 193.4 105.9C195.825 108.35 203.225 115.775 203.225 149.5C203.225 183.225 195.825 190.65 193.4 193.1Z" />
                </svg>
              )}
              {link.icon === 'scholar' && (
                <svg viewBox="0 0 16 16" fill="currentColor">
                  <path d="M8 2.2 1.5 5.4 8 8.6l6.5-3.2L8 2.2Zm0 7.5L3.2 6.9v2.4c0 1.7 2.1 3.1 4.8 3.1s4.8-1.4 4.8-3.1V6.9L8 9.7Z" />
                </svg>
              )}
              {link.icon === 'linkedin' && (
                <svg viewBox="0 0 16 16" fill="currentColor">
                  <path d="M3.2 5.6h2.1v7.2H3.2V5.6Zm1-3.3a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5ZM6.8 5.6h2v1h0c.3-.6 1.1-1.2 2.2-1.2 2.4 0 2.8 1.6 2.8 3.6v3.8h-2.1V9.5c0-.9 0-2-1.2-2s-1.4.9-1.4 1.9v3.4H6.8V5.6Z" />
                </svg>
              )}
              {link.icon === 'cv' && (
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4">
                  <path d="M4.2 2.5h5.2L12 5.1v8.4H4.2V2.5Z" stroke-linejoin="round" />
                  <path d="M9.2 2.6v2.7H12M6 8.2h4.2M6 10.5h3" stroke-linecap="round" />
                </svg>
              )}
            </span>
            {link.label}
          </a>
        ))
      }
    </div>
  </aside>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.75fr) minmax(210px, 0.85fr);
    gap: clamp(1.75rem, 4vw, 3.5rem);
    align-items: start;
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
    padding-bottom: clamp(0.5rem, 1.5vw, 1rem);
  }
  .who {
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--pencil);
    margin: 0 0 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    flex: none;
  }
  h1 {
    margin: 0;
    font-size: clamp(1.85rem, 5.1vw, 3.15rem);
    font-weight: 500;
    line-height: 1.14;
    letter-spacing: -0.024em;
  }
  h1 span {
    display: block;
  }
  .coda {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-size: 0.46em;
    line-height: 1.5;
    color: var(--pencil);
    margin-top: 0.8rem;
    letter-spacing: 0;
    max-width: 34ch;
  }
  .keywords {
    margin: 1.9rem 0 0;
    padding-top: 1.1rem;
    border-top: 1px solid var(--rule);
    font-family: var(--mono);
    font-size: 11.5px;
    line-height: 2;
    letter-spacing: 0.03em;
    color: var(--ink-70);
  }
  .keywords .sep {
    color: var(--accent);
    margin: 0 0.5em;
  }

  .margin {
    border-left: 1px solid var(--rule);
    padding-left: clamp(1rem, 2vw, 1.75rem);
  }
  .portrait {
    display: block;
    width: 112px;
    height: 112px;
    border-radius: 50%;
    object-fit: cover;
    margin: 0 auto 1.15rem;
    border: 1px solid var(--rule);
  }
  .hand {
    font-family: var(--serif);
    font-style: italic;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--ink-70);
    margin: 0 0 1.4rem;
  }
  .links {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    font-family: var(--mono);
    font-size: 11.5px;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    text-decoration: none;
    border-bottom: 1px dotted var(--rule);
    width: fit-content;
  }
  .links a:hover,
  .links a:focus-visible {
    color: var(--accent-ink);
    border-bottom-style: solid;
    border-bottom-color: var(--accent-ink);
  }
  .ico {
    display: inline-flex;
    width: 1em;
    height: 1em;
    flex: none;
    opacity: 0.8;
  }
  .ico svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .margin {
      border-left: 0;
      border-top: 1px solid var(--rule);
      padding-left: 0;
      padding-top: 1.25rem;
    }
    .links {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.9rem;
    }
  }
</style>
