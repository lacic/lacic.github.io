---
import '../styles/global.css';
import Masthead from '../components/Masthead.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { profile } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or site-relative image for link previews. */
  image?: string;
  /** Set on cross-posted articles so the other site keeps the search ranking. */
  canonical?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
}

const {
  title,
  description = profile.bio.slice(0, 300),
  image = '/air-areas.png',
  canonical,
  type = 'website',
  publishedTime,
} = Astro.props;

const fullTitle = title ? `${title} — ${profile.name}` : `${profile.name}`;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? profile.name} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="elacic.me" />
    <meta name="twitter:card" content="summary_large_image" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}

    <link rel="alternate" type="application/rss+xml" title={`${profile.name} — updates`} href="/feed.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Serif:ital,wght@0,400;0,500;1,400&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="sheet">
      <Masthead />
      <main id="main">
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>
